{
  "name": "bems-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"set ELECTRON=true&& npm run dev\" \"wait-on http://localhost:5174 && electron .\"",
    "electron:build": "npm run build -- --base=./ && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "apexcharts": "^4.0.0",
    "axios": "^1.7.9",
    "bootstrap": "^5.3.3",
    "framer-motion": "^13.2.0",
    "jsbarcode": "^3.12.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.7",
    "react-apexcharts": "^1.4.0",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.bemsfarms.pos",
    "productName": "Bems Farms Desktop",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ]
  }
}
