{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/admin/((?!assets/|css/|javascript/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|css/|javascript/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
