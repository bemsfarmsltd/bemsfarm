{
	"info": {
		"_postman_id": "bems-farms-driver-app-api-v2",
		"name": "Bems Farms - Driver Mobile Application API",
		"description": "Complete 100% Driver-Only API Collection for Bems Farms Driver Mobile App (React Native / Flutter / iOS / Android). Includes Auth, Dispatch Deliveries, Accept/Decline, POD Uploads, Wallet, Bank Verification, Push Tokens, Incident Reporting, and Emergency SOS.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://api.bemsfarms.com/api/driver",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Driver Onboarding & KYC",
			"item": [
				{
					"name": "Verify Invite Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/onboarding/verify?token=YOUR_INVITE_TOKEN",
							"host": ["{{baseUrl}}"],
							"path": ["onboarding", "verify"],
							"query": [{ "key": "token", "value": "YOUR_INVITE_TOKEN" }]
						}
					}
				},
				{
					"name": "Submit Onboarding KYC & Bank Details",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"YOUR_INVITE_TOKEN\",\n  \"nin_number\": \"12345678901\",\n  \"address\": \"14 Commercial Avenue, Maitama, Abuja\",\n  \"vehicle_type\": \"Motorcycle (Box)\",\n  \"vehicle_plate\": \"ABJ-849-XY\",\n  \"bank_name\": \"GTBank\",\n  \"account_number\": \"0123456789\",\n  \"account_name\": \"Victor Kalu\",\n  \"emergency_contact_name\": \"Sarah Kalu\",\n  \"emergency_contact_phone\": \"08098765432\",\n  \"emergency_contact_relationship\": \"Spouse\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/onboarding/submit",
							"host": ["{{baseUrl}}"],
							"path": ["onboarding", "submit"]
						}
					}
				}
			]
		},
		{
			"name": "2. Authentication & Duty Status",
			"item": [
				{
					"name": "Driver Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailOrPhone\": \"08123456789\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailOrPhone\": \"08123456789\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "forgot-password"]
						}
					}
				},
				{
					"name": "Reset Password",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"RESET_TOKEN_HERE\",\n  \"password\": \"NewPassword123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "reset-password"]
						}
					}
				},
				{
					"name": "Get Authenticated Profile",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "me"]
						}
					}
				},
				{
					"name": "Update Profile",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"08123456789\",\n  \"vehicle_type\": \"Motorcycle (Box)\",\n  \"vehicle_plate\": \"ABJ-849-XY\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/profile",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "profile"]
						}
					}
				},
				{
					"name": "Toggle Duty Availability",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"is_available\": true,\n  \"latitude\": 9.0765,\n  \"longitude\": 7.3986\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/availability",
							"host": ["{{baseUrl}}"],
							"path": ["availability"]
						}
					}
				}
			]
		},
		{
			"name": "3. Dispatch Deliveries & Orders",
			"item": [
				{
					"name": "Get Active Deliveries Queue",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/deliveries",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries"]
						}
					}
				},
				{
					"name": "Get Delivery Details Breakdown",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/deliveries/1092",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "1092"]
						}
					}
				},
				{
					"name": "Accept Delivery Assignment",
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/deliveries/1092/accept",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "1092", "accept"]
						}
					}
				},
				{
					"name": "Decline Delivery Assignment",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"reason\": \"vehicle_breakdown\",\n  \"notes\": \"Flat tyre on Airport road\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/deliveries/1092/decline",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "1092", "decline"]
						}
					}
				},
				{
					"name": "Update Milestone Status",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"delivered\",\n  \"proof_note\": \"Handed to customer Mrs. Ngozi\",\n  \"proof_photo\": \"https://api.bemsfarms.com/uploads/proofs/POD_17899_3c8f.jpg\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/deliveries/1092/status",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "1092", "status"]
						}
					}
				},
				{
					"name": "Get Delivery History",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/deliveries/history?page=1&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "history"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "20" }
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Proof of Delivery (POD) Image Upload",
			"item": [
				{
					"name": "Upload Photo Proof from Camera",
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "image",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/upload/proof",
							"host": ["{{baseUrl}}"],
							"path": ["upload", "proof"]
						}
					}
				}
			]
		},
		{
			"name": "5. GPS Telemetry",
			"item": [
				{
					"name": "Stream Background GPS Ping",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"latitude\": 9.0765,\n  \"longitude\": 7.3986,\n  \"heading\": 180.5,\n  \"speed\": 34.2,\n  \"accuracy\": 5.0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/location",
							"host": ["{{baseUrl}}"],
							"path": ["location"]
						}
					}
				}
			]
		},
		{
			"name": "6. Driver Wallet, Banks & Withdrawals",
			"item": [
				{
					"name": "Get Wallet Balance & DVA Info",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/earnings",
							"host": ["{{baseUrl}}"],
							"path": ["earnings"]
						}
					}
				},
				{
					"name": "List Nigerian Commercial Banks",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/banks",
							"host": ["{{baseUrl}}"],
							"path": ["banks"]
						}
					}
				},
				{
					"name": "Resolve NUBAN Account Name",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"account_number\": \"0123456789\",\n  \"bank_code\": \"058\",\n  \"bank_name\": \"Guaranty Trust Bank (GTBank)\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/bank/resolve",
							"host": ["{{baseUrl}}"],
							"path": ["bank", "resolve"]
						}
					}
				},
				{
					"name": "Request Withdrawal to Bank",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 10000.00,\n  \"bank_name\": \"Guaranty Trust Bank (GTBank)\",\n  \"bank_code\": \"058\",\n  \"account_number\": \"0123456789\",\n  \"account_name\": \"VICTOR KALU\",\n  \"notes\": \"Weekly earnings withdrawal\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/withdraw",
							"host": ["{{baseUrl}}"],
							"path": ["withdraw"]
						}
					}
				}
			]
		},
		{
			"name": "7. Push Tokens & Notifications",
			"item": [
				{
					"name": "Register Device Push Token",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx]\",\n  \"platform\": \"expo\",\n  \"device_info\": { \"os\": \"iOS 17.4\", \"model\": \"iPhone 15 Pro\" }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/device-token",
							"host": ["{{baseUrl}}"],
							"path": ["device-token"]
						}
					}
				},
				{
					"name": "Get Notification Inbox",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/notifications?page=1&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["notifications"],
							"query": [
								{ "key": "page", "value": "1" },
								{ "key": "limit", "value": "20" }
							]
						}
					}
				},
				{
					"name": "Mark Single Notification as Read",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/notifications/101/read",
							"host": ["{{baseUrl}}"],
							"path": ["notifications", "101", "read"]
						}
					}
				},
				{
					"name": "Mark All Notifications as Read",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/notifications/read-all",
							"host": ["{{baseUrl}}"],
							"path": ["notifications", "read-all"]
						}
					}
				}
			]
		},
		{
			"name": "8. Incident & Problem Reporting",
			"item": [
				{
					"name": "Report Mid-Trip Issue",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"issue_type\": \"customer_unreachable\",\n  \"description\": \"Customer phone switched off at gate\",\n  \"latitude\": 9.0765,\n  \"longitude\": 7.3986,\n  \"photo_urls\": [\"https://api.bemsfarms.com/uploads/proofs/gate_photo.jpg\"]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/deliveries/1092/report-issue",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "1092", "report-issue"]
						}
					}
				},
				{
					"name": "Get Incident Reports",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/incidents",
							"host": ["{{baseUrl}}"],
							"path": ["incidents"]
						}
					}
				}
			]
		},
		{
			"name": "9. Emergency SOS / Safety Panic",
			"item": [
				{
					"name": "Trigger Emergency SOS",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"latitude\": 9.0765,\n  \"longitude\": 7.3986,\n  \"address\": \"Maitama Junction, Near Transcorp Hilton\",\n  \"battery_level\": 42,\n  \"emergency_type\": \"vehicle_accident\",\n  \"notes\": \"Need immediate dispatch assistance\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/emergency",
							"host": ["{{baseUrl}}"],
							"path": ["emergency"]
						}
					}
				},
				{
					"name": "Cancel Emergency SOS",
					"request": {
						"method": "POST",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/emergency/SOS-TEST-99/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["emergency", "SOS-TEST-99", "cancel"]
						}
					}
				}
			]
		},
		{
			"name": "10. Performance Scorecard & Ratings",
			"item": [
				{
					"name": "Get Driver Stats & Ratings",
					"request": {
						"method": "GET",
						"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
						"url": {
							"raw": "{{baseUrl}}/stats",
							"host": ["{{baseUrl}}"],
							"path": ["stats"]
						}
					}
				}
			]
		}
	]
}
