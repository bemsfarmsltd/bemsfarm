{
	"info": {
		"_postman_id": "bems-farms-driver-fintech-api-v2",
		"name": "Bems Farms - Driver Mobile App & Wallet API",
		"description": "Complete API Collection for Bems Farms Driver Mobile App, Logistics Dispatch, Dedicated Virtual Accounts (Monnify), and Zone-Based Wallet Payouts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "https://api.bemsfarms.com/api/driver",
			"type": "string"
		},
		{
			"key": "adminUrl",
			"value": "https://api.bemsfarms.com/api/admin",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Driver Onboarding & Compliance",
			"item": [
				{
					"name": "Verify Invite Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/onboarding/verify?token=YOUR_INVITE_TOKEN",
							"host": ["{{baseUrl}}"],
							"path": ["onboarding", "verify"],
							"query": [
								{
									"key": "token",
									"value": "YOUR_INVITE_TOKEN"
								}
							]
						}
					}
				},
				{
					"name": "Submit Onboarding KYC & Bank Info",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token\": \"YOUR_INVITE_TOKEN\",\n  \"nin_number\": \"12345678901\",\n  \"address\": \"14 Commercial Avenue, Yaba, Lagos\",\n  \"vehicle_type\": \"Motorcycle (Box)\",\n  \"vehicle_plate\": \"KJA-849-XY\",\n  \"bank_name\": \"GTBank\",\n  \"account_number\": \"0123456789\",\n  \"account_name\": \"Victor Kalu\",\n  \"emergency_contact_name\": \"Sarah Kalu\",\n  \"emergency_contact_phone\": \"08098765432\",\n  \"emergency_contact_relationship\": \"Spouse\",\n  \"guarantor_name\": \"Chief Babatunde Kalu\",\n  \"guarantor_phone\": \"08033334444\",\n  \"guarantor_address\": \"8 Herbert Macaulay Way, Yaba\",\n  \"documents\": {\n    \"drivers_license\": \"https://storage.googleapis.com/bems-uploads/license.jpg\",\n    \"nin_slip\": \"https://storage.googleapis.com/bems-uploads/nin.jpg\"\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/onboarding/submit",
							"host": ["{{baseUrl}}"],
							"path": ["onboarding", "submit"]
						}
					}
				}
			]
		},
		{
			"name": "2. Authentication & Profile",
			"item": [
				{
					"name": "Driver Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"    console.log('Driver Token Saved!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailOrPhone\": \"08123456789\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Forgot Password Request",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailOrPhone\": \"08123456789\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/forgot-password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "forgot-password"]
						}
					}
				},
				{
					"name": "Reset Password with OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailOrPhone\": \"08123456789\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewSecurePass2026!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/reset-password",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "reset-password"]
						}
					}
				},
				{
					"name": "Get Profile & Monnify DVA (/auth/me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "me"]
						}
					}
				},
				{
					"name": "Update Profile & Settlement Bank",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phone\": \"08123456789\",\n  \"email\": \"victor.kalu@bemsfarms.com\",\n  \"bank_name\": \"GTBank\",\n  \"account_number\": \"0123456789\",\n  \"account_name\": \"Victor Kalu\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/profile",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "profile"]
						}
					}
				},
				{
					"name": "Toggle Availability (Online/Offline)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"is_available\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/availability",
							"host": ["{{baseUrl}}"],
							"path": ["availability"]
						}
					}
				}
			]
		},
		{
			"name": "3. Delivery Operations & Milestones",
			"item": [
				{
					"name": "Get Active Deliveries",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/deliveries",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries"]
						}
					}
				},
				{
					"name": "Get Delivery Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/deliveries/42",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "42"]
						}
					}
				},
				{
					"name": "Update Delivery Status (Milestone)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"delivered\",\n  \"proof_note\": \"Delivered directly to customer at front door\",\n  \"proof_photo\": \"https://storage.googleapis.com/bems-uploads/proof_delivered.jpg\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/deliveries/42/status",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "42", "status"]
						}
					}
				},
				{
					"name": "Get Delivery History",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/deliveries/history?page=1&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["deliveries", "history"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Location Telemetry",
			"item": [
				{
					"name": "Send GPS Location Ping",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"latitude\": 9.0765,\n  \"longitude\": 7.3986,\n  \"heading\": 180.0,\n  \"speed\": 35.0,\n  \"accuracy\": 4.0\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/location",
							"host": ["{{baseUrl}}"],
							"path": ["location"]
						}
					}
				}
			]
		},
		{
			"name": "5. Driver Wallet & Payouts (Driver Side)",
			"item": [
				{
					"name": "Get Driver Wallet Balance & Zone Rates",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/earnings",
							"host": ["{{baseUrl}}"],
							"path": ["earnings"]
						}
					}
				},
				{
					"name": "Request Withdrawal (Payout to Bank)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 15000,\n  \"bank_name\": \"GTBank\",\n  \"account_number\": \"0123456789\",\n  \"account_name\": \"Victor Kalu\",\n  \"notes\": \"Weekly earnings withdrawal\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/withdraw",
							"host": ["{{baseUrl}}"],
							"path": ["withdraw"]
						}
					}
				}
			]
		},
		{
			"name": "6. Admin Wallet & Payment Gateway Hub (Admin Side)",
			"item": [
				{
					"name": "Get Executive Summary & Driver Wallets",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{adminUrl}}/wallets/summary?search=&status=all",
							"host": ["{{adminUrl}}"],
							"path": ["wallets", "summary"],
							"query": [
								{
									"key": "search",
									"value": ""
								},
								{
									"key": "status",
									"value": "all"
								}
							]
						}
					}
				},
				{
					"name": "Get Zone Earnings Payout Matrix",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{adminUrl}}/wallets/zone-earnings",
							"host": ["{{adminUrl}}"],
							"path": ["wallets", "zone-earnings"]
						}
					}
				},
				{
					"name": "Update Zone Payout Rate",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"driver_earning_fee\": 1800,\n  \"driver_commission_percent\": 72\n}"
						},
						"url": {
							"raw": "{{adminUrl}}/wallets/zone-earnings/2",
							"host": ["{{adminUrl}}"],
							"path": ["wallets", "zone-earnings", "2"]
						}
					}
				},
				{
					"name": "Single Payout Disbursement (Monnify Live)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"disbursement_method\": \"monnify_transfer\",\n  \"manual_reference\": \"\",\n  \"notes\": \"Approved weekly payout\"\n}"
						},
						"url": {
							"raw": "{{adminUrl}}/wallets/payouts/1/disburse",
							"host": ["{{adminUrl}}"],
							"path": ["wallets", "payouts", "1", "disburse"]
						}
					}
				},
				{
					"name": "Bulk Batch Payout Disbursement",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"payout_ids\": [1, 2, 3],\n  \"disbursement_method\": \"monnify_transfer\",\n  \"notes\": \"Batch Friday payout run\"\n}"
						},
						"url": {
							"raw": "{{adminUrl}}/wallets/payouts/bulk-disburse",
							"host": ["{{adminUrl}}"],
							"path": ["wallets", "payouts", "bulk-disburse"]
						}
					}
				},
				{
					"name": "Provision Real Monnify DVA for Driver",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{adminUrl}}/wallets/drivers/6/provision-monnify-dva",
							"host": ["{{adminUrl}}"],
							"path": ["wallets", "drivers", "6", "provision-monnify-dva"]
						}
					}
				},
				{
					"name": "Get Monnify Gateway Live Overview & Balance",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"url": {
							"raw": "{{adminUrl}}/wallets/gateway/overview",
							"host": ["{{adminUrl}}"],
							"path": ["wallets", "gateway", "overview"]
						}
					}
				},
				{
					"name": "Validate NUBAN Account (Bank Name Resolution)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"account_number\": \"0123456789\",\n  \"bank_name\": \"GTBank\"\n}"
						},
						"url": {
							"raw": "{{adminUrl}}/wallets/validate-bank",
							"host": ["{{adminUrl}}"],
							"path": ["wallets", "validate-bank"]
						}
					}
				}
			]
		}
	]
}
